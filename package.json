{
  "name": "daigaku-long-distance-watch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "import:csv": "node --no-warnings --experimental-strip-types scripts/import-csv.ts",
    "db:push": "node --env-file-if-exists=.env.local --no-warnings --experimental-strip-types scripts/push-csv-to-supabase.ts",
    "db:pull": "node --env-file-if-exists=.env.local --no-warnings --experimental-strip-types scripts/pull-supabase-to-csv.ts",
    "test:import": "node --import tsx --test tests/result-import-parser.test.ts tests/result-import-validation.test.ts tests/season-schedule.test.ts",
    "build": "node --env-file-if-exists=.env.local --no-warnings --experimental-strip-types scripts/build-site.ts",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.1",
    "lucide-react": "latest",
    "next": "16.2.6",
    "pdf-parse": "^1.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "autoprefixer": "latest",
    "postcss": "latest",
    "tailwindcss": "3.4.17",
    "tsx": "^4.22.4",
    "typescript": "latest"
  }
}
